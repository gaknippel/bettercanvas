{
  "manifest_version": 2,
  "name": "shittyCanvas",
  "version": "0.1.0",
  "description": "Themes and quality-of-life tweaks for Canvas LMS. No accounts, no paywall, no tracking.",
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },

  "browser_specific_settings": {
    "gecko": {
      "id": "shittycanvas@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },

  "permissions": ["storage", "activeTab", "*://*.instructure.com/*"],
  "optional_permissions": ["*://*/*"],

  "background": { "scripts": ["src/background.js"] },

  "browser_action": {
    "default_title": "shittyCanvas",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.instructure.com/*"],
      "exclude_matches": ["*://www.instructure.com/*", "*://community.instructure.com/*"],
      "css": ["src/theme.css", "src/features.css"],
      "js": ["src/shared.js", "src/colormap.js", "src/theme.js", "src/darken.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instructure.com/*"],
      "exclude_matches": ["*://www.instructure.com/*", "*://community.instructure.com/*"],
      "js": ["src/features.js"],
      "run_at": "document_idle"
    }
  ]
}
